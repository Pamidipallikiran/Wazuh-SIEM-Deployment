<!-- Wazuh custom rules for the verified Suricata integration -->

<group name="local,suricata,icmp,">

  <!-- Match custom Suricata SID 1000001 -->
  <rule id="910009" level="5">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000001$</field>
    <description>Suricata: LAB ICMP Echo Request Detected</description>
    <group>suricata,icmp,</group>
  </rule>

  <!-- Aggregate two matching alerts within 30 seconds -->
  <rule id="910010" level="12" frequency="2" timeframe="30">
    <if_matched_sid>910009</if_matched_sid>
    <description>Aggregated: ICMP Echo Request Flood (&gt;=2 in 30s)</description>
    <group>suricata,icmp,flood,aggregated,</group>
  </rule>

</group>

<!--
  Additional lab detections (Suricata SIDs 1000002-1000004).

  STATUS: not yet verified against live traffic. Validate with
  /var/ossec/bin/wazuh-analysisd -t and wazuh-logtest (sample events are in
  wazuh/manager/rules/tests/) before relying on them.
-->
<group name="local,suricata,">

  <!-- SID 1000002: TCP SYN scan -->
  <rule id="910011" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000002$</field>
    <description>Suricata: LAB TCP SYN Scan Detected</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>suricata,recon,portscan,</group>
  </rule>

  <!-- SID 1000003: burst of connections to SSH -->
  <rule id="910012" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000003$</field>
    <description>Suricata: LAB SSH Connection Burst (possible brute force)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>suricata,authentication_failures,ssh,</group>
  </rule>

  <!-- SID 1000004: ICMP flood detected by Suricata threshold -->
  <rule id="910013" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^1000004$</field>
    <description>Suricata: LAB ICMP Echo Request Flood</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>suricata,icmp,flood,dos,</group>
  </rule>

</group>
